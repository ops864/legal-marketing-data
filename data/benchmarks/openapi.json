{"openapi":"3.1.1","info":{"title":"Probative benchmarks, 2025–2026: data API","version":"v1","summary":"Static, read-only JSON and CSV files. No key, no sign-up. CORS open.","description":"Probative benchmarks, 2025–2026: Probative benchmarks, 2025–2026: aggregated, rounded, and small groups suppressed. Our data on law-firm marketing, shown as bands, named tiers and rounded values, one table per file. The public tables cover how quickly inquiries become signed clients, phone calls and signed clients, AI answers and organic search clicks, search-ad click costs, what people type, calls from ads, Local Services Ads leads, inquiries by quarter and ad cost per signed client. Each row gives the measure, the band or tier, its unit and a rough size band. Every value is aggregated across many observations; values resting on too few observations, or resting mostly on a few, are suppressed for privacy. Values are approximate, so read the band, not a point. The methods page defines every measure and the protection steps.\n\nProbative is a marketing firm, not a law firm; not legal advice. Every JSON response starts with a \"meta\" object holding the credit line, citation, DOI and license (CC BY 4.0).","license":{"name":"CC BY 4.0","url":"https://creativecommons.org/licenses/by/4.0/"},"contact":{"name":"Probative Growth","url":"https://probativegrowth.com/contact/","email":"hello@probativegrowth.com"}},"servers":[{"url":"https://probativegrowth.com"}],"externalDocs":{"description":"How to use the API and the MCP server","url":"https://probativegrowth.com/resources/rules-api/"},"paths":{"/data/v1/benchmarks/index.json":{"get":{"summary":"Probative benchmarks, 2025–2026: index","description":"benchmarks: meta, summary and what the dataset holds","parameters":[],"responses":{"200":{"description":"Probative benchmarks, 2025–2026: index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/changes.json":{"get":{"summary":"Probative benchmarks, 2025–2026: confirmed changes","description":"benchmarks: confirmed changes, newest first","parameters":[],"responses":{"200":{"description":"Probative benchmarks, 2025–2026: confirmed changes","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/tables/{key}.json":{"get":{"summary":"Probative benchmarks, 2025–2026: one table","description":"benchmarks: the records for one table","parameters":[{"name":"key","in":"path","required":true,"description":"The table key, uppercase","schema":{"type":"string"},"example":"AD-CALL-OUTCOMES"}],"responses":{"200":{"description":"Probative benchmarks, 2025–2026: one table","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/benchmarks.csv":{"get":{"summary":"Probative benchmarks, 2025–2026 as CSV","description":"benchmarks: every record (credit line in README.txt)","parameters":[],"responses":{"200":{"description":"Probative benchmarks, 2025–2026 as CSV","content":{"text/csv":{"schema":{"type":"string"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/benchmarks.json":{"get":{"summary":"Probative benchmarks, 2025–2026: every record","description":"benchmarks: every record in one file","parameters":[],"responses":{"200":{"description":"Probative benchmarks, 2025–2026: every record","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/search.json":{"get":{"summary":"Probative benchmarks, 2025–2026: keyword index","description":"benchmarks: id, key, status and text of every record","parameters":[],"responses":{"200":{"description":"Probative benchmarks, 2025–2026: keyword index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}},"/data/v1/benchmarks/README.txt":{"get":{"summary":"Credit line, citation and columns","description":"benchmarks: the CSV sidecar","parameters":[],"responses":{"200":{"description":"Credit line, citation and columns","content":{"text/plain":{"schema":{"type":"string"}}}},"404":{"description":"No such file"}},"tags":["benchmarks"]}}},"components":{"schemas":{"Meta":{"type":"object","description":"Credit line, citation, DOI, version, license and disclaimer. Present in every response.","required":["dataset","version","license","attribution","disclaimer","url"],"properties":{"dataset":{"type":"string"},"title":{"type":"string"},"version":{"type":"string"},"doi":{"type":["string","null"]},"doiUrl":{"type":["string","null"]},"conceptDoi":{"type":["string","null"]},"license":{"type":"string","const":"CC BY 4.0"},"licenseUrl":{"type":"string"},"attribution":{"type":"string"},"citation":{"type":"string"},"disclaimer":{"type":"string"},"notice":{"type":"string"},"lastChecked":{"type":"string"},"url":{"type":"string"},"humanUrl":{"type":"string"},"statusCodes":{"type":"object"}}},"Envelope":{"type":"object","required":["meta"],"properties":{"meta":{"$ref":"#/components/schemas/Meta"}},"additionalProperties":true}}}}