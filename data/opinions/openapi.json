{"openapi":"3.1.1","info":{"title":"Legal-marketing ethics opinions, 2004–2026: data API","version":"v1","summary":"Static, read-only JSON and CSV files. No key, no sign-up. CORS open.","description":"Legal-marketing ethics opinions, 2004–2026: An index of US state and ABA ethics opinions, committee guidelines and court rulings on lawyer advertising and marketing, from 2004 to 2026 (most from 2015 on, plus earlier landmarks): lead generators, pay-per-lead, reviews, testimonials, trade names, websites, social media, chatbots and AI tools, competitor keywords and more. Version 1.1 adds an AI sub-index: 14 AI opinions coded on six marketing questions (chatbot disclosure, AI-made ads, intake and solicitation, superiority claims, confidentiality in marketing tools, and fees). Each record gives the issuing body, number, date, topics, a one-sentence holding in our words, a practical step, whether it is still in force, the official link, an exact short quote and the date read. It is not the opinions' full text.\n\nProbative is a marketing firm, not a law firm; not legal advice. Every JSON response starts with a \"meta\" object holding the credit line, citation, DOI and license (CC BY 4.0).","license":{"name":"CC BY 4.0","url":"https://creativecommons.org/licenses/by/4.0/"},"contact":{"name":"Probative Growth","url":"https://probativegrowth.com/contact/","email":"hello@probativegrowth.com"}},"servers":[{"url":"https://probativegrowth.com"}],"externalDocs":{"description":"How to use the API and the MCP server","url":"https://probativegrowth.com/resources/rules-api/"},"paths":{"/data/v1/opinions/index.json":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026: index","description":"opinions: meta, summary and what the dataset holds","parameters":[],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026: index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/changes.json":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026: confirmed changes","description":"opinions: confirmed changes, newest first","parameters":[],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026: confirmed changes","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/jurisdictions/{key}.json":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026: one jurisdiction","description":"opinions: the records for one jurisdiction","parameters":[{"name":"key","in":"path","required":true,"description":"The jurisdiction key, uppercase","schema":{"type":"string"}}],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026: one jurisdiction","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/opinions.csv":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026 as CSV","description":"opinions: every record (credit line in README.txt)","parameters":[],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026 as CSV","content":{"text/csv":{"schema":{"type":"string"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/opinions.json":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026: every record","description":"opinions: every record in one file","parameters":[],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026: every record","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/search.json":{"get":{"summary":"Legal-marketing ethics opinions, 2004–2026: keyword index","description":"opinions: id, key, status and text of every record","parameters":[],"responses":{"200":{"description":"Legal-marketing ethics opinions, 2004–2026: keyword index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}},"/data/v1/opinions/README.txt":{"get":{"summary":"Credit line, citation and columns","description":"opinions: the CSV sidecar","parameters":[],"responses":{"200":{"description":"Credit line, citation and columns","content":{"text/plain":{"schema":{"type":"string"}}}},"404":{"description":"No such file"}},"tags":["opinions"]}}},"components":{"schemas":{"Meta":{"type":"object","description":"Credit line, citation, DOI, version, license and disclaimer. Present in every response.","required":["dataset","version","license","attribution","disclaimer","url"],"properties":{"dataset":{"type":"string"},"title":{"type":"string"},"version":{"type":"string"},"doi":{"type":["string","null"]},"doiUrl":{"type":["string","null"]},"conceptDoi":{"type":["string","null"]},"license":{"type":"string","const":"CC BY 4.0"},"licenseUrl":{"type":"string"},"attribution":{"type":"string"},"citation":{"type":"string"},"disclaimer":{"type":"string"},"notice":{"type":"string"},"lastChecked":{"type":"string"},"url":{"type":"string"},"humanUrl":{"type":"string"},"statusCodes":{"type":"object"}}},"Envelope":{"type":"object","required":["meta"],"properties":{"meta":{"$ref":"#/components/schemas/Meta"}},"additionalProperties":true}}}}